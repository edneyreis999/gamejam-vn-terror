      <parameter index="0" type="string">====================================NOTES================================================</parameter>
    </command>
    <command index="1" code="408" indent="0">
      <parameter index="0" type="string">Shows use of script calls to refer to battler stats.</parameter>
    </command>
    <command index="2" code="408" indent="0">
      <parameter index="0" type="string">BattleManager._subject.xx refers to a user&apos;s stats. Replace the xx with other stats, like</parameter>
    </command>
    <command index="3" code="408" indent="0">
      <parameter index="0" type="string">hp, mp, tp, mp, atk, mat, def, mdf, level, and more. Use f8 to explore more </parameter>
    </command>
    <command index="4" code="408" indent="0">
      <parameter index="0" type="string">possibilities.</parameter>
    </command>
    <command index="5" code="108" indent="0">
      <parameter index="0" type="string">====================================DESCRIPTION==========================================</parameter>
    </command>
    <command index="6" code="408" indent="0">
      <parameter index="0" type="string">- Setup: Standard attack setup</parameter>
    </command>
    <command index="7" code="408" indent="0">
      <parameter index="0" type="string">- Crisis Check: Checks if user&apos;s HP equal to or greater than half max hp</parameter>
    </command>
    <command index="8" code="408" indent="0">
      <parameter index="0" type="string">- Normal Attack: If HP is higher equal to or greater than half, perform normal attack</parameter>
    </command>
    <command index="9" code="408" indent="0">
      <parameter index="0" type="string">- Crisis Attack: Else, perform two critical hits</parameter>
    </command>
    <command index="10" code="408" indent="0">
      <parameter index="0" type="string">- Finish: Standard attack finish</parameter>
    </command>
