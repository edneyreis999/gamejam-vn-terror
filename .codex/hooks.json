{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|apply_patch",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \".agents/skills/impeccable/scripts/hook.mjs\"",
                        "timeout": 5,
                        "statusMessage": "Checking UI changes"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \".agents/skills/impeccable/scripts/hook.mjs\"",
                        "timeout": 30,
                        "statusMessage": "Design deep pass"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \".claude/skills/loki-companion-mode/scripts/hook.mjs\"",
                        "timeout": 5,
                        "statusMessage": "Companion mode"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash|apply_patch|Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \".claude/skills/loki-companion-mode/scripts/hook.mjs\"",
                        "timeout": 5,
                        "statusMessage": "Companion gate"
                    }
                ]
            }
        ]
    }
}
