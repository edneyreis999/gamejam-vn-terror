    <command index="7" code="408" indent="0">
      <parameter index="0" type="string">- Setup: Standard attack setup</parameter>
    </command>
    <command index="8" code="408" indent="0">
      <parameter index="0" type="string">- Cast: User performs Cast motion</parameter>
    </command>
    <command index="9" code="408" indent="0">
      <parameter index="0" type="string">- Fire Projectile: Animation travels from user to target</parameter>
    </command>
    <command index="10" code="408" indent="0">
      <parameter index="0" type="string">- Action Effect (Flash): Apply damage, (de)buffs and play skill animation play on target</parameter>
    </command>
    <command index="11" code="408" indent="0">
      <parameter index="0" type="string">- Finish: Standard attack finish</parameter>
    </command>
    <command index="12" code="108" indent="0">
